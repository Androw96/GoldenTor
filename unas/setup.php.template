<?php
declare(strict_types=1);

const SETUP_KEY = '__GOLDENTOR_SETUP_KEY__';
$providedKey = (string) ($_SERVER['HTTP_X_GOLDENTOR_SETUP_KEY'] ?? '');
if (!hash_equals(SETUP_KEY, $providedKey)) {
    http_response_code(404);
    exit;
}

$config = require __DIR__ . '/config.php';
$database = $config['database'];
$pdo = new PDO(
    "mysql:host={$database['host']};dbname={$database['name']};charset=utf8mb4",
    $database['user'],
    $database['password'],
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
);
$schema = file_get_contents(__DIR__ . '/schema.sql');
if ($schema === false) {
    throw new RuntimeException('A sémafájl nem olvasható.');
}
foreach (explode(';', $schema) as $statement) {
    $statement = trim($statement);
    if ($statement !== '') {
        $pdo->exec($statement);
    }
}

@unlink(__FILE__);
header('Content-Type: application/json; charset=utf-8');
echo json_encode(['ok' => true]);
