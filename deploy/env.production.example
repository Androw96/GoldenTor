# This file is copied to /opt/goldentor/.env by the Oracle bootstrap script.
# Do not commit the real .env file or any value generated from it.
GOLDENTOR_HOST=127.0.0.1
GOLDENTOR_PORT=4174
GOLDENTOR_PUBLIC_URL=https://goldentor.hu

# Use a separate, long random value in production.
GOLDENTOR_ADMIN_KEY=replace-with-a-long-random-admin-key

CONTACT_RECIPIENT=info@goldentor.hu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@goldentor.hu
