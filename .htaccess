# MultiViews otherwise maps /admin to the legacy admin.html before routing runs.
Options -Indexes -MultiViews
RewriteEngine On

# One canonical origin: www.goldentor.hu -> goldentor.hu (session cookie and API origin check match).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.google.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; frame-src https://www.google.com; connect-src 'self'"
</IfModule>

# Filament admin (Laravel app in /admin-panel): Alpine.js needs 'unsafe-eval', uploads use blob: previews.
<If "%{REQUEST_URI} =~ m#^/(?:admin|livewire(?:-[a-f0-9]{8})?)(?:/|$)|^/admin-panel/public/#">
    <IfModule mod_headers.c>
        Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://ui-avatars.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; form-action 'self'; base-uri 'self'"
        Header always set X-Robots-Tag "noindex, nofollow"
    </IfModule>
</If>

# Filament admin routes -> Laravel front controller. The rest of /admin-panel is blocked
# by admin-panel/.htaccess; only its public/ folder (built CSS/JS) is reachable.
# Livewire 4 adds an installation-specific eight-character hash to its endpoint prefix.
RewriteRule ^(?:admin|livewire(?:-[a-f0-9]{8})?)(?:/.*)?$ admin-panel/public/index.php [QSA,L]

# Preserve the existing /api/... URLs while running the API on PHP/MySQL.
RewriteRule ^api/(.*)$ unas/api.php?route=$1 [QSA,L]

# These resources contain the account-only tools and are never served as plain files.
RewriteRule ^kalkulatorok\.html$ unas/protected.php?page=kalkulatorok [QSA,L]
RewriteRule ^calculator\.js$ unas/protected.php?asset=calculator [QSA,L]
RewriteRule ^insurance-market\.js$ unas/protected.php?asset=insurance [QSA,L]

# Server-side source, local data and deployment material are never public.
RewriteRule ^(?:private|data|deploy|tests|scripts|filament-admin)/ - [F,L]
RewriteRule ^admin-panel(?:-next|-previous)?/(?!public/) - [F,L]
RewriteRule ^(?:server|accounts)\.py$ - [F,L]
RewriteRule ^unas/(?:config\.php|calendar\.php|schema\.sql|config\.php\.example|reminders\.php|admin-deploy\.php\.template)$ - [F,L]
