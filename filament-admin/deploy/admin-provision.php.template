<?php
declare(strict_types=1);

// Short-lived maintenance file, deleted before executing the authenticated action.
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');
$settings = json_decode(base64_decode('__PROVISION_SETTINGS__'), true, 512, JSON_THROW_ON_ERROR);
$provided = (string) ($_SERVER['HTTP_X_GOLDENTOR_SETUP_KEY'] ?? '');
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST' || time() > $settings['expires']
    || $settings['key'] === '' || !hash_equals($settings['key'], $provided)) {
    http_response_code(404);
    exit;
}
if (!unlink(__FILE__)) {
    http_response_code(500);
    echo json_encode(['ok' => false, 'error' => 'Cannot remove temporary maintenance file']);
    exit;
}
try {
    $live = dirname(__DIR__) . '/admin-panel';
    require $live . '/vendor/autoload.php';
    $app = require $live . '/bootstrap/app.php';
    $app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
    $admin = App\Models\AdminUser::query()->firstOrCreate(
        ['email' => $settings['email']],
        ['name' => 'Golden Tor Admin', 'password' => $settings['password_hash']],
    );
    // Existing account passwords and profile data must never be overwritten.
    $created = $admin->wasRecentlyCreated;
    echo json_encode(['ok' => true, 'created' => $created, 'existing_account_preserved' => !$created]);
} catch (Throwable $error) {
    if (function_exists('report')) {
        report($error);
    }
    http_response_code(500);
    echo json_encode(['ok' => false, 'error' => 'Admin provisioning failed; inspect private application log']);
}
