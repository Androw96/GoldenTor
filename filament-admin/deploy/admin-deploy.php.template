<?php
declare(strict_types=1);

/*
 * Golden Tor – Filament admin installer on the UNAS host.
 * Uploaded by .github/workflows/deploy-admin.yml together with data/admin-panel.tar.gz,
 * then called once over HTTPS with the setup key header. It:
 *   1. checks the PHP requirements (nothing is touched if they are not met),
 *   2. unpacks the release next to the live copy,
 *   3. carries over storage/ (sessions, logs, uploads),
 *   4. swaps the folders and runs the database migrations (admin tables only).
 */

const SETUP_KEY = '__GOLDENTOR_SETUP_KEY__';

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');

function finish(array $payload, int $status = 200): void
{
    http_response_code($status);
    echo json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
    exit;
}

function remove_tree(string $path): void
{
    if (!file_exists($path) && !is_link($path)) {
        return;
    }
    if (is_file($path) || is_link($path)) {
        @unlink($path);
        return;
    }
    $items = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST
    );
    foreach ($items as $item) {
        $item->isDir() && !$item->isLink() ? @rmdir($item->getPathname()) : @unlink($item->getPathname());
    }
    @rmdir($path);
}

/**
 * Extract the GNU tar.gz release without relying on ext-phar, which is not
 * enabled by every shared-hosting PHP build. The archive is created by our
 * deployment workflow, but paths are still validated defensively here.
 */
function gz_read_exact($handle, int $length): string
{
    $data = '';
    while (strlen($data) < $length && !gzeof($handle)) {
        $chunk = gzread($handle, $length - strlen($data));
        if ($chunk === false) {
            throw new RuntimeException('A kiadási csomag nem olvasható.');
        }
        $data .= $chunk;
    }
    if (strlen($data) !== $length) {
        throw new RuntimeException('A kiadási csomag hiányos.');
    }
    return $data;
}

function safe_archive_path(string $path): string
{
    $path = str_replace('\\', '/', $path);
    while (str_starts_with($path, './')) {
        $path = substr($path, 2);
    }
    $path = ltrim($path, '/');
    if ($path === '' || str_contains($path, "\0") || preg_match('#(^|/)\.\.?($|/)#', $path)) {
        throw new RuntimeException('Érvénytelen útvonal a kiadási csomagban.');
    }
    return $path;
}

function extract_release(string $archive, string $target): void
{
    $handle = @gzopen($archive, 'rb');
    if ($handle === false) {
        throw new RuntimeException('A kiadási csomag nem nyitható meg.');
    }

    $longName = null;
    try {
        while (true) {
            $header = gz_read_exact($handle, 512);
            if ($header === str_repeat("\0", 512)) {
                break;
            }
            $name = rtrim(substr($header, 0, 100), "\0");
            $prefix = rtrim(substr($header, 345, 155), "\0");
            $sizeText = trim(rtrim(substr($header, 124, 12), "\0 "));
            $size = $sizeText === '' ? 0 : octdec($sizeText);
            $type = $header[156] ?? "\0";
            $path = $longName ?? ($prefix === '' ? $name : $prefix . '/' . $name);
            $longName = null;

            if ($type === 'L' || $type === 'x') {
                $payload = gz_read_exact($handle, $size);
                $padding = (512 - ($size % 512)) % 512;
                if ($padding) {
                    gz_read_exact($handle, $padding);
                }
                if ($type === 'L') {
                    $longName = rtrim($payload, "\0\n");
                }
                continue;
            }

            // GNU tar writes the archive root as "./". It carries no data
            // and must not become a target path itself.
            if ($path === '.' || $path === './') {
                if ($size > 0) {
                    gz_read_exact($handle, $size);
                }
                $padding = (512 - ($size % 512)) % 512;
                if ($padding) {
                    gz_read_exact($handle, $padding);
                }
                continue;
            }

            $path = safe_archive_path($path);
            $destination = $target . '/' . $path;
            if ($type === '5') {
                if (!@mkdir($destination, 0775, true) && !is_dir($destination)) {
                    throw new RuntimeException('A kiadási mappa nem hozható létre.');
                }
            } elseif ($type === "\0" || $type === '0') {
                $directory = dirname($destination);
                if (!@mkdir($directory, 0775, true) && !is_dir($directory)) {
                    throw new RuntimeException('A kiadási mappa nem hozható létre.');
                }
                $output = @fopen($destination, 'wb');
                if ($output === false) {
                    throw new RuntimeException('A kiadási fájl nem írható.');
                }
                $remaining = $size;
                while ($remaining > 0) {
                    $chunk = gz_read_exact($handle, min(1048576, $remaining));
                    if (fwrite($output, $chunk) !== strlen($chunk)) {
                        fclose($output);
                        throw new RuntimeException('A kiadási fájl írása sikertelen.');
                    }
                    $remaining -= strlen($chunk);
                }
                fclose($output);
            } else {
                throw new RuntimeException('Nem támogatott fájltípus a kiadási csomagban.');
            }

            $padding = (512 - ($size % 512)) % 512;
            if ($padding) {
                gz_read_exact($handle, $padding);
            }
        }
    } finally {
        gzclose($handle);
    }
}

$providedKey = (string) ($_SERVER['HTTP_X_GOLDENTOR_SETUP_KEY'] ?? '');
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST' || SETUP_KEY === '' || strpos(SETUP_KEY, '__GOLDENTOR') === 0 || !hash_equals(SETUP_KEY, $providedKey)) {
    http_response_code(404);
    exit;
}
$activateUploadedRelease = ($_SERVER['HTTP_X_GOLDENTOR_DEPLOY_ACTION'] ?? '') === 'activate';

@set_time_limit(600);
@ini_set('memory_limit', '512M');
ignore_user_abort(true);

$root = dirname(__DIR__);
$archive = $root . '/data/admin-panel.tar.gz';
$live = $root . '/admin-panel';
$next = $root . '/admin-panel-next';
$previous = $root . '/admin-panel-previous';
$log = [];

// 1. Requirements of Laravel 12 + Filament 5.
$missing = [];
if (PHP_VERSION_ID < 80401) {
    $missing[] = 'PHP >= 8.4 (most: ' . PHP_VERSION . ')';
}
foreach (['ctype', 'fileinfo', 'filter', 'hash', 'json', 'mbstring', 'openssl', 'pdo', 'pdo_mysql', 'session', 'tokenizer', 'xml', 'dom', 'zlib'] as $extension) {
    if (!extension_loaded($extension)) {
        $missing[] = 'ext-' . $extension;
    }
}
if ($missing) {
    finish(['ok' => false, 'step' => 'requirements', 'missing' => $missing, 'php' => PHP_VERSION], 500);
}
if (!$activateUploadedRelease && !is_file($archive)) {
    finish(['ok' => false, 'step' => 'archive', 'error' => 'data/admin-panel.tar.gz nem található.'], 500);
}

try {
    // 2. Unpack the new release.
    if ($activateUploadedRelease) {
        $log[] = 'feltöltött kiadás ellenőrizve';
    } else {
        remove_tree($next);
        @mkdir($next, 0775, true);
        extract_release($archive, $next);
    }
    if (!is_file($next . '/public/index.php') || !is_file($next . '/vendor/autoload.php')) {
        throw new RuntimeException('A kicsomagolt csomag hiányos.');
    }
    $log[] = 'kicsomagolva';

    // 3. Keep runtime data from the live copy.
    if (is_dir($live . '/storage')) {
        remove_tree($next . '/storage');
        if (!@rename($live . '/storage', $next . '/storage')) {
            throw new RuntimeException('A storage mappa nem helyezhető át.');
        }
        $log[] = 'storage megtartva';
    }
    foreach (['storage/app/public', 'storage/app/livewire-tmp', 'storage/framework/cache/data', 'storage/framework/sessions', 'storage/framework/views', 'storage/logs', 'bootstrap/cache'] as $directory) {
        if (!is_dir($next . '/' . $directory)) {
            @mkdir($next . '/' . $directory, 0775, true);
        }
    }
    foreach (glob($next . '/storage/framework/views/*.php') ?: [] as $compiled) {
        @unlink($compiled);
    }
    foreach (glob($next . '/bootstrap/cache/*.php') ?: [] as $cached) {
        @unlink($cached);
    }

    // 4. Swap folders.
    remove_tree($previous);
    if (is_dir($live) && !@rename($live, $previous)) {
        throw new RuntimeException('Az élő admin mappa nem nevezhető át.');
    }
    if (!@rename($next, $live)) {
        if (is_dir($previous)) {
            @rename($previous, $live);
        }
        throw new RuntimeException('Az új admin mappa nem élesíthető.');
    }
    $log[] = 'élesítve';

    // 5. Migrations + caches, inside the freshly deployed Laravel app.
    require $live . '/vendor/autoload.php';
    $app = require $live . '/bootstrap/app.php';
    $kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
    $kernel->bootstrap();
    $exit = $kernel->call('migrate', ['--force' => true]);
    $log[] = 'migrate: ' . trim($kernel->output());
    if ($exit !== 0) {
        throw new RuntimeException('A migráció sikertelen.');
    }
    foreach (['filament:optimize', 'view:cache'] as $command) {
        try {
            $kernel->call($command);
            $log[] = $command . ' kész';
        } catch (Throwable $error) {
            $log[] = $command . ' kihagyva: ' . $error->getMessage();
        }
    }

    @unlink($archive);
    remove_tree($previous);

    $hasAdmin = (bool) Illuminate\Support\Facades\DB::table('admin_users')->exists();
    finish([
        'ok' => true,
        'php' => PHP_VERSION,
        'log' => $log,
        'next' => $hasAdmin ? 'https://goldentor.hu/admin' : 'https://goldentor.hu/admin/setup',
    ]);
} catch (Throwable $error) {
    finish(['ok' => false, 'error' => get_class($error) . ': ' . $error->getMessage(), 'log' => $log], 500);
}
